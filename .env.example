# Copy to .env and fill in. Never commit .env.

# Data: Zetaris (local install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password
# Leave empty to auto-detect the Docker network whose name contains "zetaris"
ZETARIS_DOCKER_NETWORK=

# Source databases (Postgres in Docker, registered in Zetaris)
PG_PASSWORD=choose-a-local-password

# Power: Meterless Nightshift (values from Nightshift's Console)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=meterless/auto
NEMOTRON_DEEP=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_LOCAL=local-runtime/nemotron-3-nano-30b-a3b

# Demo and runtime
# SAMPLE_MODE=true runs everything without Zetaris, Nightshift or network access (recorded replies + rule-based planner)
SAMPLE_MODE=false
PORT=8000
# Inside Docker, localhost is the container: use host.docker.internal for Zetaris and Nightshift, e.g.
# ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
# MODEL_BASE_URL=http://host.docker.internal:8088/v1
